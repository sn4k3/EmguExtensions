<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <ProductName>EmguExtensions.Avalonia</ProductName>
    <Title>EmguExtensions for Avalonia</Title>
    <Description>Avalonia integration for EmguExtensions: convert Emgu.CV Mat images to Avalonia WriteableBitmap with direct memory locking.</Description>
    <PackageTags>emgu;emgucv;opencv;avalonia;writeablebitmap;mat;image-processing</PackageTags>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <!-- Used directly (Span2D), keep it in sync with the version of EmguExtensions -->
    <PackageReference Include="CommunityToolkit.HighPerformance" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EmguExtensions\EmguExtensions.csproj" />
  </ItemGroup>
</Project>
