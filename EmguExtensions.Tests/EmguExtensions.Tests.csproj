<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="10.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- Headless platform, to test the WriteableBitmap conversions without a window -->
    <PackageReference Include="Avalonia.Headless" Version="12.1.3" />
    <!-- Skia backs the bitmaps, the headless drawing stub does not keep the pixels between locks -->
    <PackageReference Include="Avalonia.Skia" Version="12.1.3" />

    <PackageReference Include="Emgu.CV.runtime.mini.macos" Version="4.13.0.5924" />
    <PackageReference Include="Emgu.CV.runtime.mini.ubuntu-x64" Version="4.12.0.5764" />
    <PackageReference Include="Emgu.CV.runtime.mini.windows" Version="4.13.0.5924" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EmguExtensions\EmguExtensions.csproj" />
    <ProjectReference Include="..\EmguExtensions.Avalonia\EmguExtensions.Avalonia.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="UnitTestExtensionFixes.cs" />
  </ItemGroup>
</Project>
