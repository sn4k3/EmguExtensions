<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Emgu 5 Windows native-only packages use framework-neutral dependency groups.
             Keep their NuGet compatibility warnings visible without failing the test build. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1701</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="10.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- Headless platform, to test the WriteableBitmap conversions without a window -->
    <PackageReference Include="Avalonia.Headless" Version="12.1.4" />
    <!-- Skia backs the bitmaps, the headless drawing stub does not keep the pixels between locks -->
    <PackageReference Include="Avalonia.Skia" Version="12.1.4" />

    <PackageReference Include="Emgu.CV.runtime.mini.macos" Version="5.0.0.6584" />
    <PackageReference Include="Emgu.CV.runtime.mini.ubuntu-26.04-x64" Version="5.0.0.6584" />
    <PackageReference Include="Emgu.CV.runtime.mini.windows" Version="5.0.0.6584" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EmguExtensions\EmguExtensions.csproj" />
    <ProjectReference Include="..\EmguExtensions.Avalonia\EmguExtensions.Avalonia.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="UnitTestExtensionFixes.cs" />
  </ItemGroup>
</Project>
